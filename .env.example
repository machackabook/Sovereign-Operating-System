# Google Gemini API Key for server-side AI reasoning & speech
GEMINI_API_KEY=

# Optional: Comma-separated fallback Gemini API keys
GEMINI_API_KEYS=

# Google Maps API Key for Maps Platform & Geolocation proxy
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Custom backend URL (defaults to same origin)
VITE_CHAT_BACKEND_URL=

# Port for local dev server (default 3000)
PORT=3000

# Node environment (development or production)
NODE_ENV=development

# Firebase Web API Key (if overriding firebase-applet-config.json)
FIREBASE_API_KEY=
