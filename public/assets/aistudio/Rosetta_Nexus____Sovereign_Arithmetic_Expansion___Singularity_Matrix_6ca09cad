                               <span class="text-red-400" id="val-thermal">130.81 Hz</span>
                           </div>
                           <input type="range" id="slider-thermal" class="w-full accent-red-500 h-1 bg-white/10 rounded-lg appearance-none" min="50" max="500" value="130">
                       </div>

                       <div>
                           <div class="flex justify-between text-gray-400 mb-1">
                               <span>SEPIROTH SUBSTITUTION SCALE</span>
                               <span class="text-cyan-400" id="val-quantum">523.25 Hz</span>



                            </div>
                           <input type="range" id="slider-quantum" class="w-full accent-cyan-400 h-1 bg-white/10 rounded-lg appearance-none" min="200" max="1000" value="523">
                       </div>

                       <div>
                           <div class="flex justify-between text-gray-400 mb-1">
                               <span>GRAVITATIONAL INTENSITY</span>
                               <span class="text-purple-400" id="val-kinetic">1.60G</span>
                           </div>
                           <input type="range" id="slider-kinetic" class="w-full accent-purple-500 h-1 bg-white/10 rounded-lg appearance-none" min="10" max="50" value="16">
                       </div>
                   </div>
               </div>

               <!-- Live Stream Data Feed Log -->
               <div class="matrix-panel flex-1 rounded-xl p-4 flex flex-col overflow-hidden">
                   <div class="flex justify-between items-center border-b border-white/10 pb-2 mb-2">
                       <span class="text-xs font-bold tracking-wider text-gray-300">CORE LOGSTREAM</span>
                       <button onclick="clearTelemetryLog()" class="text-[9px] hover:text-white transition-colors text-gray-500 uppercase">Molt</button>



                    </div>
                   <div id="telemetry-feed" class="flex-1 overflow-y-auto space-y-1 font-mono text-[10px] text-gray-400 pr-1">
                       <!-- Stream Entries Injected At Runtime -->
                   </div>
               </div>
           </div>
       </main>

       <!-- INTERACTIVE DOCK AND INPUT DECK -->
       <footer class="dock-system pointer-events-auto">
           <div class="matrix-panel p-3 rounded-xl flex items-center justify-between gap-4">
               <div class="flex gap-2">
                   <button onclick="triggerCorePulse()" class="px-3 py-1.5 rounded-lg bg-red-950/40 border border-red-500/30 hover:bg-red-900/40 transition-colors text-red-400 text-xs font-bold tracking-wider">
                       PULSE
                   </button>
                   <button onclick="copyCoreSnapshot()" class="px-3 py-1.5 rounded-lg bg-neutral-900 border border-white/10 hover:bg-neutral-800 transition-colors text-gray-300 text-xs tracking-wider">
                       SNAPSHOT
                   </button>
               </div>




                <div class="flex-1 max-w-lg relative flex items-center">
                   <span class="absolute left-3 text-cyan-400 font-bold text-xs">$((</span>
                   <input type="text" id="terminal-input" placeholder="expression )) e.g., base_freq * 2" class="w-full bg-black/40 border border-white/10 rounded-lg py-1.5 pl-12 pr-8 text-xs font-mono text-white outline-none focus:border-cyan-500/50 transition-colors">
                   <span class="absolute right-3 text-cyan-400 font-bold text-xs">))</span>
               </div>

               <div class="text-[10px] text-gray-500 font-bold tracking-widest hidden sm:block">
                   POSIX_EXP_v4
