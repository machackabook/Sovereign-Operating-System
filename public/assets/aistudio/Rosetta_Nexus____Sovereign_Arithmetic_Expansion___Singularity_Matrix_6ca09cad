           <!-- CENTER CONVERGENCE ASSIGNMENT AXIS (TRANSPARENT SEPIROTH GAP) -->
           <div class="flex-1 h-full flex items-center justify-center relative">
               <!-- Three.js renders central black hole system inside canvas directly behind this container -->
           </div>




            <!-- RIGHT COLUMN: ELEMENTAL SPECTRUM & TRANSMUTATION -->
           <div class="w-80 h-full flex flex-col gap-4 pointer-events-auto">
               <!-- Transmutation Matrix Controls -->
               <div class="matrix-panel rounded-xl p-4 flex flex-col gap-3">
                   <span class="text-xs font-bold tracking-wider text-gray-300 border-b border-white/10 pb-2">TRANSMUTATION SIMULATOR</span>
                   
                   <div class="space-y-2 text-[11px]">
                       <div>
                           <div class="flex justify-between text-gray-400 mb-1">
