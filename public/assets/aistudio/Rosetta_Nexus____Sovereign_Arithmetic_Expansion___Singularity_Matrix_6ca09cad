       <!-- MAIN OPERATIONAL VIEWPORT -->



        <main class="w-full flex-1 flex justify-between items-center my-4 overflow-hidden gap-4">
           
           <!-- LEFT COLUMN: HISTORICAL TRACES & CODES -->
           <div class="w-80 h-full flex flex-col gap-4 pointer-events-auto">
               <div class="matrix-panel flex-1 rounded-xl p-4 flex flex-col overflow-hidden">
                   <div class="flex justify-between items-center border-b border-white/10 pb-2 mb-2">
                       <span class="text-xs font-bold tracking-wider text-gray-300">HISTORICAL VARIANTS</span>
