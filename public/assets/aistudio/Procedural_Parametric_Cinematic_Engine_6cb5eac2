       // Main Simulation Dynamic Loop Frame Animation Routine Controller
       function executeRenderPipelineTickFrame(currentTimestampDelta) {
           const realTimeStepDelta = currentTimestampDelta - lastFrameTimestamp;
           lastFrameTimestamp = currentTimestampDelta;
           
           diagnosticFrameCounter++;
           if (diagnosticFrameCounter % 10 === 0) {
               document.getElementById('render-fps').textContent = `FPS: ${Math.round(1000 / (realTimeStepDelta || 1))}`;
           }




            const operationalSpeedFactorConstantStepUnit = (linearVelocity * 0.016); 
           sProgress += operationalSpeedFactorConstantStepUnit;

           const liveCalculusFrameState = analyzeFrenetSerretFrameMatrixState(sProgress);

           vectorHelpersGroup.visible = showVectors;
           trackLineMesh.material.opacity = showTrack ? 0.65 : 0.0;

           if (showVectors) {
               tangentArrowHelper.position.copy(liveCalculusFrameState.position);
               tangentArrowHelper.setDirection(liveCalculusFrameState.tangent);

               normalArrowHelper.position.copy(liveCalculusFrameState.position);
               normalArrowHelper.setDirection(liveCalculusFrameState.normal);

               binormalArrowHelper.position.copy(liveCalculusFrameState.position);
               binormalArrowHelper.setDirection(liveCalculusFrameState.binormal);
           }




            const currentInstantSpeedValue = linearVelocity;
           const calculatedInstantCentripetalGForce = (currentInstantSpeedValue * currentInstantSpeedValue) * liveCalculusFrameState.curvature;

           document.getElementById('hud-curvature').textContent = liveCalculusFrameState.curvature.toFixed(4);
           document.getElementById('hud-arc').textContent = `${(sProgress % totalArcLength).toFixed(1)}m / ${totalArcLength.toFixed(0)}m`;
           document.getElementById('hud-gforce').textContent = `${(calculatedInstantCentripetalGForce / 9.81).toFixed(2)}G`;

           if (activeCameraMode === 'director') {
               const eyeHeightElevationOffset = 0.85;
               const activeCameraCalculatedEyePosition = liveCalculusFrameState.position.clone().addScaledVector(new THREE.Vector3(0, 1, 0), eyeHeightElevationOffset);
               camera.position.copy(activeCameraCalculatedEyePosition);

               const cameraLookAheadForwardSightDistanceVectorScale = 4.0;
               const lookTargetCoordinatePositionAnchor = liveCalculusFrameState.position.clone().addScaledVector(liveCalculusFrameState.tangent, cameraLookAheadForwardSightDistanceVectorScale);
               camera.lookAt(lookTargetCoordinatePositionAnchor);

               if (simulateGimbalBanking) {
                   const bankingStrengthMultiplierFactor = 0.28;
                   const calculatedDynamicBankingUpVectorDirectionState = new THREE.Vector3(0, 1, 0).addScaledVector(liveCalculusFrameState.normal, calculatedInstantCentripetalGForce * bankingStrengthMultiplierFactor).normalize();



                    camera.up.copy(calculatedDynamicBankingUpVectorDirectionState);
               } else {
                   camera.up.set(0, 1, 0);
               }
           } else {
               const orbitLoopRadiusDistance = alphaCoeff * 1.5;
               const orbitLoopSpeedFrequencyTimeParamFactor = currentTimestampDelta * 0.0002;
               
               camera.position.set(
                   Math.cos(orbitLoopSpeedFrequencyTimeParamFactor) * orbitLoopRadiusDistance,
                   alphaCoeff * 0.9,
                   Math.sin(orbitLoopSpeedFrequencyTimeParamFactor) * orbitLoopRadiusDistance
               );
               camera.lookAt(liveCalculusFrameState.position);
               camera.up.set(0, 1, 0);
           }

           renderer.render(scene, camera);
           requestAnimationFrame(executeRenderPipelineTickFrame);



        }

       // Operational Interface System Layout Binding Controls Wireframe Setup Hook
       function attachInterfaceControlsListenersFrameworkHooks() {
           document.getElementById('sel-preset').addEventListener('change', (e) => {
               activePreset = e.target.value;
               sProgress = 0;
               precomputeArcLengthParameterizationMatrix();
               rebuildProceduralCinematicEnvironmentMeshMatrix();
           });

           document.getElementById('slide-speed').addEventListener('input', (e) => {
               linearVelocity = parseFloat(e.target.value);
               document.getElementById('txt-speed').textContent = `${linearVelocity.toFixed(2)} m/s`;
           });

           document.getElementById('slide-alpha').addEventListener('input', (e) => {
               alphaCoeff = parseFloat(e.target.value);
               document.getElementById('txt-alpha').textContent = alphaCoeff.toFixed(2);



                precomputeArcLengthParameterizationMatrix();
               rebuildProceduralCinematicEnvironmentMeshMatrix();
           });

           document.getElementById('slide-wall').addEventListener('input', (e) => {
               wallScalar = parseFloat(e.target.value);
               document.getElementById('txt-wall').textContent = `${wallScalar.toFixed(1)}x`;
               rebuildProceduralCinematicEnvironmentMeshMatrix();
           });

           const btnDir = document.getElementById('btn-cam-director');
           const btnOrb = document.getElementById('btn-cam-orbit');

           btnDir.addEventListener('click', () => {
               activeCameraMode = 'director';
               document.getElementById('hud-cam-mode').textContent = "Director Tangent";
               btnDir.className = "bg-emerald-600 font-bold text-gray-950 py-2 px-3 rounded text-left transition border border-emerald-500";
               btnOrb.className = "bg-gray-900 text-gray-400 py-2 px-3 rounded text-left transition border border-gray-800 hover:border-gray-700";
           });




            btnOrb.addEventListener('click', () => {
               activeCameraMode = 'orbit';
               document.getElementById('hud-cam-mode').textContent = "Drone Orbital";
               btnOrb.className = "bg-emerald-600 font-bold text-gray-950 py-2 px-3 rounded text-left transition border border-emerald-500";
               btnDir.className = "bg-gray-900 text-gray-400 py-2 px-3 rounded text-left transition border border-gray-800 hover:border-gray-700";
           });

           document.getElementById('chk-gimbal').addEventListener('change', (e) => simulateGimbalBanking = e.target.checked);
           document.getElementById('chk-vectors').addEventListener('change', (e) => showVectors = e.target.checked);
           document.getElementById('chk-track').addEventListener('change', (e) => showTrack = e.target.checked);
       }

       // Global Orchestration Entry Point Initialisation Configuration Loop Rule Call trigger
       window.onload = function() {
           initializeThreeEngineEnvironmentContext();
           attachInterfaceControlsListenersFrameworkHooks();
           
           // Modern ResizeObserver: Detects layout shifts, flex modifications, or preview window resizing natively.
           const containerResizeEngineObserver = new ResizeObserver((observedEntries) => {



                if (!container || !renderer || !camera) return;
               
               // Read fresh rendering block boundaries
               const currentObservedWidth = container.clientWidth;
               const currentObservedHeight = container.clientHeight;
               
               if (currentObservedWidth > 0 && currentObservedHeight > 0) {
                   camera.aspect = currentObservedWidth / currentObservedHeight;
                   camera.updateProjectionMatrix();
                   renderer.setSize(currentObservedWidth, currentObservedHeight);
               }
           });
           containerResizeEngineObserver.observe(container);

           requestAnimationFrame(executeRenderPipelineTickFrame);
       };
   </script>
</body>
