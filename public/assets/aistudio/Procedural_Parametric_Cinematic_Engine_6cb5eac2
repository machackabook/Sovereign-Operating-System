       let wallScalar = 4.5;
       
       let trackLookupTable = []; // Arc-Length Uniform Mapping Integration Vector Spline Array Table
       let totalArcLength = 0;

       // Visual Asset Nodes Reference Group
       let trackLineMesh = null;
