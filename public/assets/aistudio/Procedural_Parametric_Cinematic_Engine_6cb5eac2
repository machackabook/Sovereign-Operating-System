       // Core Mathematical Functions Definitions Mapping
       function computeRawSplineCoordinate(timeParameter, presetKey, alpha, beta) {
           let x = 0, y = 0, z = 0;
           const arg = beta * timeParameter;




            if (presetKey === 'quantum') {
               x = alpha * (Math.cos(arg) + 0.5 * Math.cos(2 * arg) + 0.5 * Math.cos(4 * arg) + 0.375 * Math.cos(8 * arg));
               y = alpha * (2 * Math.sin(arg) - Math.sin(2 * arg) + Math.sin(4 * arg) - 0.75 * Math.sin(8 * arg));
               z = alpha * 0.45 * Math.sin(3 * arg); 
           } else if (presetKey === 'butterfly') {
               const factor = Math.exp(Math.cos(arg)) - 2 * Math.cos(4 * arg) - Math.pow(Math.sin(arg / 12), 5);
               x = alpha * 0.6 * Math.sin(arg) * factor;
               y = alpha * 0.6 * Math.cos(arg) * factor;
               z = alpha * 0.3 * Math.cos(3 * arg);
           } else if (presetKey === 'lissajous') {
               x = alpha * 1.2 * Math.sin(3 * arg + Math.PI / 2);
               y = alpha * 1.2 * Math.sin(4 * arg);
               z = alpha * 0.8 * Math.cos(2 * arg);
           } else { 
               x = alpha * (1.1 * Math.cos(arg) + 0.5 * Math.cos(3.5 * arg));
               y = alpha * (1.1 * Math.sin(arg) - 0.5 * Math.sin(3.5 * arg));
               z = alpha * 0.4 * Math.sin(2 * arg);
           }
           return new THREE.Vector3(x, z, -y); 



        }

       // Numerical Integration Quadrature Engine for Uniform Speed Reparameterization Mapping Matrix
       function precomputeArcLengthParameterizationMatrix() {
           trackLookupTable = [];
           totalArcLength = 0;
           
           const numericalSamplingIntervalSteps = 2000;
           const maxRangeT = activePreset === 'butterfly' ? Math.PI * 24 : Math.PI * 2;
           
           let previousCoordinate = computeRawSplineCoordinate(0, activePreset, alphaCoeff, betaCoeff);
           trackLookupTable.push({ t: 0, s: 0, position: previousCoordinate.clone() });

           for (let step = 1; step <= numericalSamplingIntervalSteps; step++) {
               const currentT = (step / numericalSamplingIntervalSteps) * maxRangeT;
               const currentCoordinate = computeRawSplineCoordinate(currentT, activePreset, alphaCoeff, betaCoeff);
               
               const incrementalDistanceDelta = currentCoordinate.distanceTo(previousCoordinate);
               totalArcLength += incrementalDistanceDelta;



                
               trackLookupTable.push({
                   t: currentT,
                   s: totalArcLength,
                   position: currentCoordinate.clone()
               });
               previousCoordinate = currentCoordinate.clone();
           }
       }

       // Dynamic Mapping Resolution: Lookup Interpolated Position In Continuous Arc Length Space Domain
       function queryPositionAtArcLengthDistance(targetS) {
           let boundedS = targetS % totalArcLength;
           if (boundedS < 0) boundedS += totalArcLength;

           let lowerBoundIndex = 0;
           let upperBoundIndex = trackLookupTable.length - 1;

           while (lowerBoundIndex < upperBoundIndex - 1) {



                const midpointIndex = Math.floor((lowerBoundIndex + upperBoundIndex) / 2);
               if (trackLookupTable[midpointIndex].s < boundedS) {
                   lowerBoundIndex = midpointIndex;
               } else {
                   upperBoundIndex = midpointIndex;
               }
           }

           const lowerRecord = trackLookupTable[lowerBoundIndex];
           const upperRecord = trackLookupTable[upperBoundIndex];
           
           if (upperRecord.s === lowerRecord.s) return lowerRecord.position.clone();

           const linearInterpolationRatioFactor = (boundedS - lowerRecord.s) / (upperRecord.s - lowerRecord.s);
           return new THREE.Vector3().lerpVectors(lowerRecord.position, upperRecord.position, linearInterpolationRatioFactor);
       }

       // Discrete Kinematics Engine Evaluating Frenet-Serret Vector Frame Space Orientation Tensors
       function analyzeFrenetSerretFrameMatrixState(targetS) {



            const infinitesimalDeltaDistanceStep = 0.02;

           const positionBackward = queryPositionAtArcLengthDistance(targetS - infinitesimalDeltaDistanceStep);
           const positionCenter   = queryPositionAtArcLengthDistance(targetS);
           const positionForward  = queryPositionAtArcLengthDistance(targetS + infinitesimalDeltaDistanceStep);

           const tangentVector = new THREE.Vector3().subVectors(positionForward, positionBackward).normalize();

           const deltaVectorForward  = new THREE.Vector3().subVectors(positionForward, positionCenter);
           const deltaVectorBackward = new THREE.Vector3().subVectors(positionCenter, positionBackward);
           const differentialSecondDerivativeVector = new THREE.Vector3().subVectors(deltaVectorForward, deltaVectorBackward);

           const instantaneousCurvatureKappa = differentialSecondDerivativeVector.length() / (infinitesimalDeltaDistanceStep * infinitesimalDeltaDistanceStep);

           const normalVector = differentialSecondDerivativeVector.clone().normalize();
           
           if (normalVector.lengthSq() === 0 || isNaN(normalVector.x)) {
               normalVector.set(0, 1, 0).projectOnPlane(tangentVector).normalize();
           }




            const binormalVector = new THREE.Vector3().crossVectors(tangentVector, normalVector).normalize();

           return {
               position: positionCenter,
               tangent: tangentVector,
               normal: normalVector,
               binormal: binormalVector,
               curvature: instantaneousCurvatureKappa
           };
       }

       // Scene Generation Engine: Procedural Mesh Geometry Pipeline Construction Assembly
       function rebuildProceduralCinematicEnvironmentMeshMatrix() {
           if (trackLineMesh) scene.remove(trackLineMesh);
           if (environmentMeshGroup) scene.remove(environmentMeshGroup);
           if (vectorHelpersGroup) scene.remove(vectorHelpersGroup);

           environmentMeshGroup = new THREE.Group();
           vectorHelpersGroup = new THREE.Group();



            scene.add(environmentMeshGroup);
           scene.add(vectorHelpersGroup);

           const trackLineGeometry = new THREE.BufferGeometry();
           const trackLinePositions = [];

           const visualizationPathSegmentsResolution = 400;
           for (let segmentIndex = 0; segmentIndex <= visualizationPathSegmentsResolution; segmentIndex++) {
               const currentDistanceTarget = (segmentIndex / visualizationPathSegmentsResolution) * totalArcLength;
               const positionVector = queryPositionAtArcLengthDistance(currentDistanceTarget);
               trackLinePositions.push(positionVector.x, positionVector.y, positionVector.z);
           }

           trackLineGeometry.setAttribute('position', new THREE.Float32BufferAttribute(trackLinePositions, 3));
           const trackLineMaterial = new THREE.LineBasicMaterial({
               color: 0x10b981,
               linewidth: 2,
               transparent: true,
               opacity: showTrack ? 0.65 : 0.0



            });
           trackLineMesh = new THREE.Line(trackLineGeometry, trackLineMaterial);
           scene.add(trackLineMesh);

           const wallSlicesStepsResolution = 250;
           const wallRibbonWidthDistanceOffset = 3.5; 
           
           const leftWallVerticesPositionsArray = [];
           const rightWallVerticesPositionsArray = [];

           for (let sliceIndex = 0; sliceIndex <= wallSlicesStepsResolution; sliceIndex++) {
               const spatialDistanceTarget = (sliceIndex / wallSlicesStepsResolution) * totalArcLength;
               const frameState = analyzeFrenetSerretFrameMatrixState(spatialDistanceTarget);

               const rawWallHeightScale = Math.max(0.5, frameState.curvature * 85.0 * wallScalar);
               
               const leftBaseOffsetPoint = frameState.position.clone().addScaledVector(frameState.binormal, wallRibbonWidthDistanceOffset);
               const leftTopOffsetPoint  = leftBaseOffsetPoint.clone().addScaledVector(new THREE.Vector3(0, 1, 0), rawWallHeightScale);




                const rightBaseOffsetPoint = frameState.position.clone().addScaledVector(frameState.binormal, -wallRibbonWidthDistanceOffset);
               const rightTopOffsetPoint  = rightBaseOffsetPoint.clone().addScaledVector(new THREE.Vector3(0, 1, 0), rawWallHeightScale);

               leftWallVerticesPositionsArray.push(leftBaseOffsetPoint.x, leftBaseOffsetPoint.y, leftBaseOffsetPoint.z);
               leftWallVerticesPositionsArray.push(leftTopOffsetPoint.x, leftTopOffsetPoint.y, leftTopOffsetPoint.z);

               rightWallVerticesPositionsArray.push(rightBaseOffsetPoint.x, rightBaseOffsetPoint.y, rightBaseOffsetPoint.z);
               rightWallVerticesPositionsArray.push(rightTopOffsetPoint.x, rightTopOffsetPoint.y, rightTopOffsetPoint.z);
           }

           function generateMeshRibbonFromCalculatedBuffers(positionsData, colorHex) {
               const ribbonGeometry = new THREE.BufferGeometry();
               const totalCalculatedPointsCount = positionsData.length / 3;
               const indexTrianglesBufferArray = [];

               for (let i = 0; i < (totalCalculatedPointsCount - 2); i += 2) {
                   indexTrianglesBufferArray.push(i, i + 1, i + 2);
                   indexTrianglesBufferArray.push(i + 1, i + 3, i + 2);
               }




                ribbonGeometry.setAttribute('position', new THREE.Float32BufferAttribute(positionsData, 3));
               ribbonGeometry.setIndex(indexTrianglesBufferArray);
               ribbonGeometry.computeVertexNormals();

               const wireframeMaterial = new THREE.MeshBasicMaterial({
                   color: colorHex,
                   wireframe: true,
                   transparent: true,
                   opacity: 0.14,
                   side: THREE.DoubleSide
               });

               return new THREE.Mesh(ribbonGeometry, wireframeMaterial);
           }

           const leftBoundaryStructuralMesh = generateMeshRibbonFromCalculatedBuffers(leftWallVerticesPositionsArray, 0x06b6d4);
           const rightBoundaryStructuralMesh = generateMeshRibbonFromCalculatedBuffers(rightWallVerticesPositionsArray, 0xec4899);

           environmentMeshGroup.add(leftBoundaryStructuralMesh);



            environmentMeshGroup.add(rightBoundaryStructuralMesh);

           const floorGridHelper = new THREE.GridHelper(150, 60, 0x1e293b, 0x0f172a);
           floorGridHelper.position.y = -10;
           environmentMeshGroup.add(floorGridHelper);

           vehicleAnchorNode = new THREE.Object3D();
           scene.add(vehicleAnchorNode);

           const arrowLenMetric = 2.5;
           tangentArrowHelper = new THREE.ArrowHelper(new THREE.Vector3(1,0,0), new THREE.Vector3(0,0,0), arrowLenMetric, 0x22d3ee, 0.4, 0.2);
           normalArrowHelper  = new THREE.ArrowHelper(new THREE.Vector3(0,1,0), new THREE.Vector3(0,0,0), arrowLenMetric, 0xf43f5e, 0.4, 0.2);
           binormalArrowHelper = new THREE.ArrowHelper(new THREE.Vector3(0,0,1), new THREE.Vector3(0,0,0), arrowLenMetric, 0xfacc15, 0.4, 0.2);

           vectorHelpersGroup.add(tangentArrowHelper);
           vectorHelpersGroup.add(normalArrowHelper);
           vectorHelpersGroup.add(binormalArrowHelper);
       }




