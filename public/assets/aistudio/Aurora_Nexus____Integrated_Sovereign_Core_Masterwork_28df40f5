                    el.className = "py-1 rounded bg-purple-950/50 border border-purple-500/50 text-purple-300 font-bold shadow-[0_0_8px_rgba(179,71,255,0.3)]";
               } else {
                   el.className = "py-1 rounded bg-black/40 border border-white/5 text-gray-500";
               }
           }

           const currentStageObj = GovernanceStages[Hyper_State.currentGovPhase - 1];
           document.getElementById('gov-action-description').innerText = currentStageObj.desc;

           // Emit structured token characters sequence into the console stream mapping
           const randomizedGlyphString = Array.from({length: 12}, () => RecurrenceGlyphs[Math.floor(Math.random() * RecurrenceGlyphs.length)]).join('');
           logAction("RECURRENCE", `Ledger snapshot committed sequence alignment: ${randomizedGlyphString}`);
       }

       // Switch Engine Sovereign Color Target States
       function selectSovereignEdition(key, activeBtn) {
           Hyper_State.activeEdition = key;
           logAction("EDITION_MIGRATION", `Unified single-core switched context parameters to: ${SovereignEditions[key].label}`);
           



            const buttons = document.getElementById('sovereign-palette-deck').children;
           for(let b of buttons) {
               b.classList.remove('bg-white/10', 'border-white/40');
           }
           activeBtn.classList.add('bg-white/10', 'border-white/40');

           // Flash visual core system scale on changing primary vector pipelines
           if (particleSystem) {
               particleSystem.scale.set(1.15, 1.15, 1.15);
               setTimeout(() => particleSystem.scale.set(1.0, 1.0, 1.0), 250);
           }
       }

       // Interface Input & Param Mux Bindings
       function setupTelemetryInputMux() {
           // Slider 1: Vorticity
           document.getElementById('param-vorticity').addEventListener('input', function(e) {
               Hyper_State.vorticity = parseFloat(e.target.value) / 100;
               document.getElementById('lbl-vorticity').innerText = Hyper_State.vorticity.toFixed(2) + " ζ";



            });

           // Slider 2: Chaos Coefficient
           document.getElementById('param-chaos').addEventListener('input', function(e) {
               Hyper_State.chaos = parseFloat(e.target.value) / 100;
               document.getElementById('lbl-chaos').innerText = Hyper_State.chaos.toFixed(2) + " T_LOW";
           });

           // Slider 3: Coupling Matrix Boundary
           document.getElementById('param-coupling').addEventListener('input', function(e) {
               Hyper_State.coupling = parseFloat(e.target.value) / 1000;
               document.getElementById('lbl-coupling').innerText = Hyper_State.coupling.toFixed(3) + " Matrix";
           });

           // Arithmetic Deck Interceptor Dispatcher Loop
           document.getElementById('arithmetic-deck-input').addEventListener('keydown', function(e) {
               if (e.key === 'Enter' && this.value.trim()) {
                   const expressionText = this.value.trim();
                   logAction("POSIX_ARITH", `Processing expansion wrapper segment: $(( ${expressionText} ))`);




                    try {
                       // Map local context tokens down onto algebraic literal string replacements
                       let formattedExpr = expressionText
                           .replace(/vorticity/g, Hyper_State.vorticity)
                           .replace(/chaos/g, Hyper_State.chaos)
                           .replace(/coupling/g, Hyper_State.coupling)
                           .replace(/wrot/g, Hyper_State.wrot)
                           .replace(/step/g, Hyper_State.step);

                       // Strip illegal text configurations to preserve integer parameters safety
                       let sanitizedExpr = formattedExpr.replace(/[^0-9.+\-*/().\s]/g, '');
                       let calculationResult = eval(sanitizedExpr);

                       if (calculationResult !== undefined && !isNaN(calculationResult)) {
                           logAction("EXP_RESOLVED", `Output value literal: ${calculationResult}`);
                           
                           // Dynamically modulate rotation matrix parameters if calculation fits parameters limits
                           if (calculationResult > 0 && calculationResult < 6.28) {
                               Hyper_State.wrot = parseFloat(calculationResult);



                                document.getElementById('stat-wrot').innerText = Hyper_State.wrot.toFixed(2);
                           }
                       } else {
                           logAction("EXP_TEXT", "String array processed context as standard double-quoted token data.");
                       }
                   } catch (err) {
                       logAction("ERR_LEX_PARSE", "Failed parsing arithmetic sequence string expressions.");
                   }
                   this.value = '';
               }
           });
       }

       // Functional Log Stream Logging Utilities
       function logAction(tag, message) {
           const feed = document.getElementById('matrix-console-log');
           const timestamp = new Date().toISOString().slice(11, 19);
           const row = document.createElement('div');
           row.className = "py-0.5 border-b border-white/[0.005] leading-normal truncate";



            row.innerHTML = `[${timestamp}] <span class="text-cyan-400 font-bold">[${tag}]</span> ${message}`;
           
           feed.appendChild(row);
           feed.scrollTop = feed.scrollHeight;

           // Restrict maximum logging stack height
           while (feed.children.length > 30) {
               feed.removeChild(feed.firstChild);
           }
       }

       function clearConsoleLog() {
           document.getElementById('matrix-console-log').innerHTML = '';
           logAction("CACHE_PURGE", "Molt sequence complete. Caches cleared successfully.");
       }

       function toggleVoidProjection() {
           document.body.classList.toggle('void-mode-active');
           logAction("VIEWPORT_MUX", "Toggled absolute 100:100 viewport focus boundaries.");



        }

       function onViewportResizeUpdate() {
           const container = document.getElementById('symplecticVoidContainer');
           camera.aspect = container.clientWidth / container.clientHeight;
           camera.updateProjectionMatrix();
           renderer.setSize(container.clientWidth, container.clientHeight, false);
       }
   </script>
