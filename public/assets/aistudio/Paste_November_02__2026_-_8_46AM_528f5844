            className={`p-1.5 text-xs border rounded-md transition-colors ${
              isInspectorOpen ? 'bg-indigo-50 border-indigo-200 text-indigo-700' : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
            }`}
          >
            <Eye className="w-4 h-4" />
          </button>
        </div>
      </header>

      {/* Filter & Sub-Nav Bar */}
      <div className="h-11 bg-white border-b border-slate-200 px-4 flex items-center justify-between shrink-0 text-xs z-10">
        <div className="flex items-center space-x-3 flex-1 max-w-3xl">
          <div className="relative flex-1 max-w-xs sm:max-w-sm">
            <Search className="w-3.5 h-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400" />
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search by name, ID, domain, capabilities..."
              className="w-full pl-8 pr-7 py-1 text-xs bg-slate-50 border border-slate-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:bg-white text-slate-800"
            />
            {searchQuery && (
              <button
                onClick={() => setSearchQuery('')}
                className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"
              >
                <X className="w-3.5 h-3.5" />
              </button>
            )}
          </div>

          {/* Type Filter */}
          <div className="flex items-center space-x-1.5">
            <span className="text-slate-600 text-[11px] font-medium hidden sm:inline">Type:</span>
            <select
              value={selectedTypeFilter}
              onChange={(e) => setSelectedTypeFilter(e.target.value)}
              className="py-1 px-2 text-xs bg-slate-50 border border-slate-200 rounded-md text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500"
            >
              <option value="ALL">All Types ({entities.length})</option>
              {uniqueTypes.map(t => (
                <option key={t} value={t}>{t}</option>
              ))}
            </select>
          </div>

          {/* Domain Filter */}
          <div className="flex items-center space-x-1.5">
            <span className="text-slate-600 text-[11px] font-medium hidden sm:inline">Domain:</span>
            <select
              value={selectedDomainFilter}
              onChange={(e) => setSelectedDomainFilter(e.target.value)}
              className="py-1 px-2 text-xs bg-slate-50 border border-slate-200 rounded-md text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500"
            >
              <option value="ALL">All Domains</option>
              {uniqueDomains.map(d => (
                <option key={d} value={d}>{d}</option>
              ))}
            </select>
          </div>

          {(searchQuery || selectedTypeFilter !== 'ALL' || selectedDomainFilter !== 'ALL') && (
            <button
              onClick={() => {
                setSearchQuery('');
                setSelectedTypeFilter('ALL');
                setSelectedDomainFilter('ALL');
              }}
              className="text-[11px] text-indigo-600 hover:text-indigo-800 font-medium underline"
            >
              Reset Filters
            </button>
          )}
        </div>

        {/* Canvas Layout Modes */}
        {activeTab === 'canvas' && (
          <div className="flex items-center space-x-2">
            <span className="text-[11px] text-slate-600 font-medium hidden md:inline">Arrangement:</span>
            <div className="flex bg-slate-100 rounded-md p-0.5 border border-slate-200">
              <button
                onClick={() => setLayoutMode('topology')}
                className={`px-2 py-0.5 text-[11px] rounded transition-all ${
                  layoutMode === 'topology' ? 'bg-white font-semibold text-indigo-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'
                }`}
              >
                Topological Mesh
              </button>
              <button
                onClick={() => setLayoutMode('concentric')}
                className={`px-2 py-0.5 text-[11px] rounded transition-all ${
                  layoutMode === 'concentric' ? 'bg-white font-semibold text-indigo-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'
                }`}
              >
                Concentric Orbit
              </button>
              <button
                onClick={() => setLayoutMode('cluster')}
                className={`px-2 py-0.5 text-[11px] rounded transition-all ${
                  layoutMode === 'cluster' ? 'bg-white font-semibold text-indigo-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'
                }`}
              >
                Domain Sectors
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Main Workspace Area */}
      <div className="flex-1 flex relative overflow-hidden">
        {/* VIEW 1: SPATIAL CANVAS */}
        {activeTab === 'canvas' && (
          <div className="flex-1 relative h-full w-full bg-slate-50 overflow-hidden cursor-crosshair">
            <svg
              ref={svgRef}
              className="w-full h-full block select-none"
              onMouseDown={handleSvgMouseDown}
            >
              <defs>
                <pattern id="canvas-grid" width="32" height="32" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1.2" fill="#94a3b8" opacity="0.4" />
                </pattern>
                <filter id="selectionGlow" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur stdDeviation="4" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>

              <rect id="canvas-background" width="100%" height="100%" fill="url(#canvas-grid)" />

              <g transform={`translate(${transform.x}, ${transform.y}) scale(${transform.k})`}>
                {/* Guide Orbits */}
                <circle id="canvas-guide-plane" cx={1200} cy={800} r={720} fill="none" stroke="#cbd5e1" strokeWidth="1.2" strokeDasharray="6 6" opacity="0.6" />
                <circle cx={1200} cy={800} r={480} fill="none" stroke="#cbd5e1" strokeWidth="1.2" strokeDasharray="6 6" opacity="0.6" />
                <circle cx={1200} cy={800} r={240} fill="none" stroke="#cbd5e1" strokeWidth="1.2" strokeDasharray="6 6" opacity="0.6" />

                {/* Filaments / Inter-node Links */}
                {graphLinks.map((link, idx) => {
                  const sourcePos = nodePositions[link.source];
                  const targetPos = nodePositions[link.target];
                  if (!sourcePos || !targetPos) return null;

                  const isHighlighted = (selectedId === link.source || selectedId === link.target);

                  return (
                    <g key={`link-${idx}`}>
                      <line
                        x1={sourcePos.x}
                        y1={sourcePos.y}
                        x2={targetPos.x}
                        y2={targetPos.y}
                        stroke={isHighlighted ? '#4f46e5' : '#94a3b8'}
                        strokeWidth={isHighlighted ? 2.5 : 1.2}
                        strokeOpacity={isHighlighted ? 0.95 : 0.35}
                        strokeDasharray={link.weight > 3 ? 'none' : '4 4'}
                      />
                      {isHighlighted && (
                        <circle
                          cx={(sourcePos.x + targetPos.x) / 2}
                          cy={(sourcePos.y + targetPos.y) / 2}
                          r={3.5}
                          fill="#4338ca"
                        />
                      )}
                    </g>
                  );
                })}

                {/* Nodes */}
                {entities.map(node => {
                  const pos = nodePositions[node.id] || { x: 1200, y: 800 };
                  const isSelected = selectedId === node.id;
                  const styling = getTypeStyling(node.type);
                  const isMatched = filteredEntities.some(fe => fe.id === node.id);
                  const symbol = getVisualSymbol(node.visual, node.name);

                  const displayName = node.name.length > 22 ? `${node.name.slice(0, 20)}…` : node.name;
                  const cardWidth = Math.max(110, displayName.length * 7 + 24);
                  const cardHeight = 36;

                  return (
                    <g
                      key={node.id}
                      transform={`translate(${pos.x}, ${pos.y})`}
                      opacity={isMatched ? 1 : 0.22}
                      className="cursor-pointer"
                      onClick={(e) => {
                        e.stopPropagation();
                        setSelectedId(node.id);
                        if (!isInspectorOpen) setIsInspectorOpen(true);
                      }}
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        setDraggedNode(node.id);
                      }}
                    >
                      {/* Active Ring Indicator */}
                      {isSelected && (
                        <circle
                          r={32}
                          fill="none"
                          stroke="#6366f1"
                          strokeWidth="2.5"
                          strokeDasharray="5 3"
                        />
                      )}

                      {/* Main Node Circle */}
                      <circle
                        r={24}
                        fill={isSelected ? '#e0e7ff' : '#ffffff'}
                        stroke={isSelected ? '#4f46e5' : styling.border}
                        strokeWidth={isSelected ? 3 : 2}
                        filter={isSelected ? 'url(#selectionGlow)' : undefined}
                      />

                      {/* Node Glyph Symbol */}
                      <text
                        textAnchor="middle"
                        dominantBaseline="central"
                        fontSize={14}
                        fontWeight="bold"
                        fill={styling.fill}
                        className="pointer-events-none select-none font-mono"
                      >
                        {symbol}
                      </text>

                      {/* Operational Status Bead */}
                      <circle
                        cx={16}
                        cy={-16}
                        r={5}
                        fill={getNodeStatusColor(node.state)}
                        stroke="#ffffff"
                        strokeWidth="1.5"
                      />

                      {/* Pill Container */}
                      <g transform="translate(0, 30)">
                        <rect
                          x={-cardWidth / 2}
                          y={-2}
                          width={cardWidth}
                          height={cardHeight}
                          rx={6}
                          fill="#ffffff"
                          fillOpacity={0.96}
                          stroke={isSelected ? '#6366f1' : '#cbd5e1'}
