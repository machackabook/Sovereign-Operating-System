              </button>
              <button
                onClick={() => setEditingItem({ ...selectedEntity })}
                className="flex items-center space-x-1.5 px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md text-xs font-medium shadow-sm transition-colors"
              >
                <Edit3 className="w-3.5 h-3.5" />
                <span>Edit Specs</span>
              </button>
            </div>
          </aside>
        )}
      </div>

      {/* MODAL: EDIT ENTITY */}
      {editingItem && (
        <div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl shadow-2xl border border-slate-200 max-w-xl w-full overflow-hidden flex flex-col max-h-[90vh]">
            <div className="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <Edit3 className="w-4 h-4 text-indigo-600" />
                <h3 className="text-sm font-bold text-slate-900">Edit Architecture Node: {editingItem.name}</h3>
              </div>
              <button
                onClick={() => setEditingItem(null)}
                className="text-slate-400 hover:text-slate-600 p-1"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form onSubmit={handleSaveEdit} className="p-5 overflow-y-auto space-y-4 text-xs">
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Entity ID</label>
                  <input
                    type="text"
                    required
                    value={editingItem.id}
                    onChange={(e) => setEditingItem({ ...editingItem, id: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Type</label>
                  <input
                    type="text"
                    required
                    value={editingItem.type}
                    onChange={(e) => setEditingItem({ ...editingItem, type: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Display Name</label>
                <input
                  type="text"
                  required
                  value={editingItem.name}
                  onChange={(e) => setEditingItem({ ...editingItem, name: e.target.value })}
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Description</label>
                <textarea
                  rows={3}
                  value={editingItem.description}
                  onChange={(e) => setEditingItem({ ...editingItem, description: e.target.value })}
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 leading-relaxed"
                />
              </div>

              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Domain</label>
                  <input
                    type="text"
                    value={editingItem.domain}
                    onChange={(e) => setEditingItem({ ...editingItem, domain: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">State</label>
                  <input
                    type="text"
                    value={editingItem.state}
                    onChange={(e) => setEditingItem({ ...editingItem, state: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Confidence</label>
                  <input
                    type="text"
                    value={editingItem.confidence}
                    onChange={(e) => setEditingItem({ ...editingItem, confidence: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Capabilities (comma separated)</label>
                <input
                  type="text"
                  value={editingItem.capabilities}
                  onChange={(e) => setEditingItem({ ...editingItem, capabilities: e.target.value })}
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Visual Representation</label>
                <input
                  type="text"
                  value={editingItem.visual}
                  onChange={(e) => setEditingItem({ ...editingItem, visual: e.target.value })}
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Provenance Source</label>
                  <input
                    type="text"
                    value={editingItem.provenance}
                    onChange={(e) => setEditingItem({ ...editingItem, provenance: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Source Index</label>
                  <input
                    type="text"
                    value={editingItem.source}
                    onChange={(e) => setEditingItem({ ...editingItem, source: e.target.value })}
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
              </div>

              <div className="pt-3 border-t border-slate-200 flex justify-end space-x-2">
                <button
                  type="button"
                  onClick={() => setEditingItem(null)}
                  className="px-4 py-2 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-md font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md font-medium shadow-sm"
                >
                  Save Modifications
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* MODAL: REGISTER NEW ENTITY */}
      {isAddModalOpen && (
        <div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl shadow-2xl border border-slate-200 max-w-xl w-full overflow-hidden flex flex-col max-h-[90vh]">
            <div className="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <Plus className="w-4 h-4 text-indigo-600" />
                <h3 className="text-sm font-bold text-slate-900">Register New Architectural Node</h3>
              </div>
              <button
                onClick={() => setIsAddModalOpen(false)}
                className="text-slate-400 hover:text-slate-600 p-1"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form
              onSubmit={(e) => {
                const fd = new FormData(e.currentTarget);
                handleSaveAdd(e, {
                  id: fd.get('id'),
                  type: fd.get('type'),
                  name: fd.get('name'),
                  description: fd.get('description'),
                  domain: fd.get('domain'),
                  state: fd.get('state'),
                  confidence: fd.get('confidence'),
                  capabilities: fd.get('capabilities'),
                  visual: fd.get('visual'),
                  provenance: fd.get('provenance'),
                  source: fd.get('source')
                });
              }}
              className="p-5 overflow-y-auto space-y-4 text-xs"
            >
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Node Identifier (id)</label>
                  <input
                    name="id"
                    type="text"
                    required
                    placeholder="e.g. quantum-matrix"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Architecture Type</label>
                  <input
                    name="type"
                    type="text"
                    required
                    defaultValue="system"
                    placeholder="system, engine, subsystem..."
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Display Name</label>
                <input
                  name="name"
                  type="text"
                  required
                  placeholder="e.g. Quantum Matrix Optimizer"
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Description</label>
                <textarea
                  name="description"
                  rows={3}
                  placeholder="Architectural purpose and runtime responsibilities..."
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Domain</label>
                  <input
                    name="domain"
                    type="text"
                    defaultValue="runtime, governance"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">State</label>
                  <input
                    name="state"
                    type="text"
                    defaultValue="active"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Confidence</label>
                  <input
                    name="confidence"
                    type="text"
                    defaultValue="1.0"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Capabilities (comma separated)</label>
                <input
                  name="capabilities"
                  type="text"
                  placeholder="identity, persistence, validation..."
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                />
              </div>

              <div>
                <label className="block text-[11px] font-semibold text-slate-700 mb-1">Visual Representation</label>
                <input
                  name="visual"
                  type="text"
                  placeholder="node / sprite.tensor / pulse animation"
                  className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500 font-mono"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Provenance Source</label>
                  <input
                    name="provenance"
                    type="text"
                    defaultValue="Architecture Registry"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
                <div>
                  <label className="block text-[11px] font-semibold text-slate-700 mb-1">Source Index</label>
                  <input
                    name="source"
                    type="text"
                    defaultValue="1"
                    className="w-full px-2.5 py-1.5 border border-slate-200 rounded-md focus:ring-1 focus:ring-indigo-500"
                  />
                </div>
              </div>

              <div className="pt-3 border-t border-slate-200 flex justify-end space-x-2">
                <button
                  type="button"
                  onClick={() => setIsAddModalOpen(false)}
                  className="px-4 py-2 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-md font-medium"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md font-medium shadow-sm"
                >
                  Insert Node into Canvas
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* CONFIRM DELETE MODAL */}
      {deleteConfirmItem && (
        <div className="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-xl shadow-xl border border-slate-200 max-w-sm w-full p-5 space-y-4">
            <div className="flex items-center space-x-3 text-rose-600">
              <div className="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center shrink-0">
                <AlertCircle className="w-5 h-5" />
              </div>
              <div>
                <h4 className="text-sm font-bold text-slate-900">Decommission Entity?</h4>
                <p className="text-xs text-slate-600">Row index {deleteConfirmItem.index_} will be permanently removed.</p>
              </div>
            </div>
            <p className="text-xs text-slate-700 bg-slate-50 p-2.5 rounded-lg border border-slate-200">
              Are you sure you want to remove <span className="font-semibold text-slate-900">{deleteConfirmItem.name}</span> ({deleteConfirmItem.id}) from the living canvas?
            </p>
            <div className="flex justify-end space-x-2 pt-1">
              <button
                onClick={() => setDeleteConfirmItem(null)}
                className="px-3 py-1.5 border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-md text-xs font-medium"
              >
                Cancel
              </button>
              <button
                onClick={handleDeleteConfirm}
                className="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-md text-xs font-medium shadow-sm"
              >
                Confirm Delete
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}