                          fontSize={11}
                          fontWeight={isSelected ? '700' : '600'}
                          fill="#0f172a"
                          className="pointer-events-none select-none"
                        >
                          {displayName}
                        </text>
                        <text
                          y={26}
                          textAnchor="middle"
                          fontSize={9}
                          fontWeight="700"
                          fill="#475569"
                          className="pointer-events-none select-none uppercase tracking-wider font-mono"
                        >
                          {node.type.length > 18 ? `${node.type.slice(0, 16)}…` : node.type}
                        </text>
