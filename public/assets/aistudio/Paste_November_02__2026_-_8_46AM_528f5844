                })}
              </g>
            </svg>

            {/* Floating View Controls */}
            <div className="absolute bottom-5 left-5 bg-white/95 border border-slate-200 rounded-lg shadow-md p-1.5 flex items-center space-x-1 text-slate-700 z-10">
              <button
                onClick={() => setTransform(prev => ({ ...prev, k: Math.min(3.0, prev.k + 0.15) }))}
                title="Zoom In"
                className="p-1.5 hover:bg-slate-100 rounded-md transition-colors text-slate-700 hover:text-slate-900"
              >
                <ZoomIn className="w-4 h-4" />
              </button>
              <button
                onClick={() => setTransform(prev => ({ ...prev, k: Math.max(0.2, prev.k - 0.15) }))}
                title="Zoom Out"
                className="p-1.5 hover:bg-slate-100 rounded-md transition-colors text-slate-700 hover:text-slate-900"
              >
                <ZoomOut className="w-4 h-4" />
              </button>
              <div className="w-px h-4 bg-slate-200" />
              <button
                onClick={zoomToFit}
                title="Fit All Nodes in View"
                className="p-1.5 hover:bg-slate-100 rounded-md transition-colors text-slate-700 hover:text-slate-900"
              >
                <Maximize2 className="w-4 h-4" />
              </button>
              <button
                onClick={resetView}
                title="Reset Viewport"
                className="p-1.5 hover:bg-slate-100 rounded-md transition-colors text-slate-700 hover:text-slate-900"
              >
                <RotateCcw className="w-4 h-4" />
              </button>
              <button
                onClick={() => centerOnNode(selectedId)}
                title="Center Selected Node"
