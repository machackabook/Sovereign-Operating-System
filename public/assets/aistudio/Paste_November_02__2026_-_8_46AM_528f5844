import React, { useState, useMemo, useRef, useEffect, useCallback } from 'react';
import * as d3 from 'd3';
import {
  Search, Plus, Trash2, Edit3, X, ChevronRight,
  ZoomIn, ZoomOut, RotateCcw, Grid, Layers, Network,
  Activity, Cpu, Database, Shield, Eye, Workflow,
  Maximize2, AlertCircle, Compass, Info, ArrowUpDown,
  ChevronUp, ChevronDown, Move
} from 'lucide-react';

// --- Built-in Seed Data for Standalone Execution & Fallback ---
const DEFAULT_SYSTEM_DATA = [
  { index_: 0, row: [ 'id', 'type', 'name', 'description', 'domain', 'state', 'confidence', 'capabilities', 'visual_representation', 'provenance_source', 'source' ] },
  { index_: 1, row: [ 'adam', 'architecture-core', 'Adam Nexus Core', 'Primary cognitive synthesis kernel and root governance agent orchestrating cross-domain convergence.', 'governance, reasoning, core', 'active', '0.99', 'orchestration, consensus, goal-synthesis, reflection', 'pulsing-crystal-core', 'Core System Specification v4.2', '1' ] },
  { index_: 2, row: [ 'nexus-prime', 'system-router', 'Nexus Prime Gateway', 'High-throughput asynchronous communication backbone and message broker routing topological event streams.', 'network, mesh, runtime', 'active', '0.97', 'stream-routing, protocol-translation, packet-telemetry', 'starfield-tensor-matrix', 'Network Fabric Whitepaper', '2' ] },
  { index_: 3, row: [ 'gaianexus', 'ecosystem-fabric', 'GaiaNexus Planetary Mesh', 'Distributed multi-agent fabric providing distributed physical resource allocation and sensor grid syncing.', 'network, governance, sensory', 'active', '0.95', 'edge-sync, geographic-sharding, environmental-telemetry', 'planetary-orbital-lattice', 'Planetary Compute RFC-11', '3' ] },
  { index_: 4, row: [ 'project-chimera', 'architecture-core', 'Project Chimera Bridge', 'Hybrid neuro-symbolic reasoning substrate linking probabilistic models with strict deterministic logical solvers.', 'reasoning, intelligence, ai', 'active', '0.94', 'theorem-proving, latent-grounding, deductive-planning', 'tesseract-hypercube', 'Chimera Theoretical Spec', '4' ] },
  { index_: 5, row: [ 'dream-engine', 'intelligence-engine', 'Dream Simulation Engine', 'Counterfactual state generator running Monte Carlo scenario explorations during idle cognitive cycles.', 'simulation, reasoning, ai', 'self-healing stable', '0.91', 'world-modeling, predictive-rollout, heuristic-pruning', 'nebula-cloud-emitter', 'Autonomous Cognition Paper', '5' ] },
  { index_: 6, row: [ 'hamiltonian-router', 'logic-engine', 'Hamiltonian Path Router', 'Discrete optimization engine computing minimal energy paths across heterogeneous distributed compute clusters.', 'network, computation, runtime', 'active', '0.98', 'graph-partitioning, latency-reduction, load-balancing', 'dynamic-vector-field', 'Cluster Optimization Protocol', '6' ] },
  { index_: 7, row: [ 'vfs-quantum-store', 'storage-substrate', 'VFS Continuum Fabric', 'Content-addressable persistent memory layer with cryptographic provenance tracking and zero-latency indexing.', 'memory, persistence, storage', 'active', '0.99', 'immutable-audit, zero-copy-read, Merkle-dag-sync', 'hexagonal-memory-hive', 'Distributed Storage Standard', '7' ] },
  { index_: 8, row: [ 'tesseract-canvas', 'interface-anchor', 'Tesseract Sensory Canvas', 'Multi-dimensional visual projection layer mapping hyper-dimensional latent representations to interactive surfaces.', 'visual, sensory, interface', 'active', '0.93', 'spatial-projection, real-time-telemetry, vector-rendering', 'infinite-canvas-matrix', 'Sensory Interface Guidelines', '8' ] },
  { index_: 9, row: [ 'sentinel-daemon', 'daemon-protocol', 'Sentinel Health Daemon', 'Automated fault detection, real-time telemetry resonance inspector, and self-healing subsystem restarter.', 'governance, telemetry, runtime', 'active', '0.96', 'anomaly-detection, heartbeat-pulse, circuit-breaking', 'beacon-pulse-emitter', 'Fault Resilience Directive', '9' ] },
  { index_: 10, row: [ 'semantic-anchor', 'subsystem-module', 'Semantic Vector Anchor', 'Dynamic contextual embedding memory anchor providing nearest-neighbor semantic search over system states.', 'memory, ai, intelligence', 'active', '0.92', 'dense-retrieval, token-quantization, context-windowing', 'vector-cluster-cloud', 'Semantic Indexing Manual', '10' ] }
];

export default function App({
  data,
  updateItem,
  deleteItem,
  insertItem,
  moveItem,
  followLink
}: {
  data?: Array<{ index_: number; row: any[] }>;
  updateItem?: (index: number, row: any[]) => void;
  deleteItem?: (index: number) => void;
  insertItem?: (index?: number, row?: any[]) => void;
  moveItem?: (from: number, to: number) => void;
  followLink?: (url: string) => void;
}) {
  // --- Local Fallback State (Ensures standalone & connected usage) ---
  const [internalData, setInternalData] = useState(() => (data && data.length ? data : DEFAULT_SYSTEM_DATA));

  useEffect(() => {
    if (data && data.length > 0) {
      setInternalData(data);
    }
  }, [data]);

  // Fallback wrappers for CRUD when used without external host
  const handleUpdateItem = useCallback((idx: number, updatedRow: any[]) => {
    if (updateItem) {
      updateItem(idx, updatedRow);
    } else {
      setInternalData(prev => prev.map(item => item.index_ === idx ? { ...item, row: updatedRow } : item));
    }
  }, [updateItem]);

  const handleDeleteItem = useCallback((idx: number) => {
    if (deleteItem) {
      deleteItem(idx);
    } else {
      setInternalData(prev => prev.filter(item => item.index_ !== idx));
    }
  }, [deleteItem]);

  const handleInsertItem = useCallback((newRow: any[]) => {
    if (insertItem) {
      insertItem(undefined, newRow);
    } else {
      setInternalData(prev => {
        const nextIdx = prev.reduce((max, cur) => Math.max(max, cur.index_), 0) + 1;
        return [...prev, { index_: nextIdx, row: newRow }];
      });
    }
  }, [insertItem]);

  // --- View & Interaction State ---
  const [activeTab, setActiveTab] = useState<'canvas' | 'grid' | 'telemetry'>('canvas');
  const [layoutMode, setLayoutMode] = useState<'topology' | 'concentric' | 'cluster'>('topology');
  const [selectedId, setSelectedId] = useState('adam');
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedTypeFilter, setSelectedTypeFilter] = useState('ALL');
  const [selectedDomainFilter, setSelectedDomainFilter] = useState('ALL');
  const [isInspectorOpen, setIsInspectorOpen] = useState(true);

  // Table Sort State
  const [sortField, setSortField] = useState<'index_' | 'name' | 'type' | 'state' | 'confidence'>('index_');
  const [sortAsc, setSortAsc] = useState(true);

  // --- CRUD Modals State ---
  const [editingItem, setEditingItem] = useState<any | null>(null);
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [deleteConfirmItem, setDeleteConfirmItem] = useState<any | null>(null);

  // --- Canvas Pan & Zoom State ---
  const [transform, setTransform] = useState({ x: 80, y: 40, k: 0.72 });
  const [isPanning, setIsPanning] = useState(false);
  const panStartRef = useRef({ x: 0, y: 0 });
  const [draggedNode, setDraggedNode] = useState<string | null>(null);
  const [customPositions, setCustomPositions] = useState<Record<string, { x: number; y: number }>>({});
  const svgRef = useRef<SVGSVGElement | null>(null);

  // --- Dynamic Column Discovery & Mapping ---
  const headerRow = useMemo(() => {
    if (!internalData || !internalData.length) return null;
    return internalData.find(item => item.row && item.row.includes('id') && item.row.includes('name')) || internalData[0];
  }, [internalData]);

  const colMap = useMemo(() => {
    const defaultMap = {
      id: 0,
      type: 1,
      name: 2,
      description: 3,
      domain: 4,
      state: 5,
      confidence: 6,
      capabilities: 7,
      visual_representation: 8,
      provenance_source: 9,
      source: 10
    };
    if (!headerRow || !headerRow.row) return defaultMap;
    const h = headerRow.row;
    const findIdx = (str: string) => {
      const idx = h.findIndex(col => typeof col === 'string' && col.toLowerCase().trim() === str.toLowerCase().trim());
      return idx !== -1 ? idx : -1;
    };

    return {
      id: findIdx('id') !== -1 ? findIdx('id') : 0,
      type: findIdx('type') !== -1 ? findIdx('type') : 1,
      name: findIdx('name') !== -1 ? findIdx('name') : 2,
      description: findIdx('description') !== -1 ? findIdx('description') : 3,
      domain: findIdx('domain') !== -1 ? findIdx('domain') : 4,
      state: findIdx('state') !== -1 ? findIdx('state') : 5,
      confidence: findIdx('confidence') !== -1 ? findIdx('confidence') : 6,
      capabilities: findIdx('capabilities') !== -1 ? findIdx('capabilities') : 7,
      visual_representation: findIdx('visual_representation') !== -1 ? findIdx('visual_representation') : 8,
      provenance_source: findIdx('provenance_source') !== -1 ? findIdx('provenance_source') : 9,
      source: findIdx('source') !== -1 ? findIdx('source') : 10
    };
  }, [headerRow]);

  // --- Normalized Entity Dataset ---
  const entities = useMemo(() => {
    if (!internalData || !internalData.length) return [];
    const headerIdx = headerRow ? headerRow.index_ : 0;
    return internalData
      .filter(item => item.index_ !== headerIdx && item.row && item.row.length > 1 && item.row.some(val => val !== null && val !== ''))
      .map(item => {
        const r = item.row;
        const id = String(r[colMap.id] ?? `node-${item.index_}`).trim();
        const type = String(r[colMap.type] ?? 'entity').trim();
        const name = String(r[colMap.name] ?? id).trim();
        const description = String(r[colMap.description] ?? '').trim();
        const domain = String(r[colMap.domain] ?? '').trim();
        const state = String(r[colMap.state] ?? 'active').trim();
        const confidence = String(r[colMap.confidence] ?? '1.0').trim();
        const capabilities = String(r[colMap.capabilities] ?? '').trim();
        const visual = String(r[colMap.visual_representation] ?? '').trim();
        const provenance = String(r[colMap.provenance_source] ?? '').trim();
        const source = String(r[colMap.source] ?? '').trim();

        return {
          index_: item.index_,
          id,
          type,
          name,
          description,
          domain,
          state,
          confidence,
          capabilities,
          visual,
          provenance,
          source,
          rawRow: r
        };
      });
  }, [internalData, headerRow, colMap]);

  // Active selected node object
  const selectedEntity = useMemo(() => {
    if (!entities.length) return null;
    return entities.find(e => e.id === selectedId) || entities[0];
  }, [entities, selectedId]);

  // Filter Categories
  const uniqueTypes = useMemo(() => {
    const set = new Set(entities.map(e => e.type).filter(Boolean));
    return Array.from(set).sort();
  }, [entities]);

  const uniqueDomains = useMemo(() => {
    const list: string[] = [];
    entities.forEach(e => {
      e.domain.split(',').forEach(d => {
        const trimmed = d.trim();
        if (trimmed && !list.includes(trimmed)) list.push(trimmed);
      });
    });
    return list.sort();
  }, [entities]);

  // Filtered Entities for views
  const filteredEntities = useMemo(() => {
    const q = searchQuery.toLowerCase().trim();
    return entities.filter(e => {
      const matchesSearch = !q || (
        e.name.toLowerCase().includes(q) ||
        e.id.toLowerCase().includes(q) ||
        e.description.toLowerCase().includes(q) ||
        e.domain.toLowerCase().includes(q) ||
        e.capabilities.toLowerCase().includes(q) ||
        e.visual.toLowerCase().includes(q)
      );

      const matchesType = selectedTypeFilter === 'ALL' || e.type.toLowerCase() === selectedTypeFilter.toLowerCase();
      const matchesDomain = selectedDomainFilter === 'ALL' || e.domain.toLowerCase().includes(selectedDomainFilter.toLowerCase());

      return matchesSearch && matchesType && matchesDomain;
    });
  }, [entities, searchQuery, selectedTypeFilter, selectedDomainFilter]);

  // Sorted list for Grid view
  const sortedEntities = useMemo(() => {
    return [...filteredEntities].sort((a, b) => {
      let valA: any = a[sortField];
      let valB: any = b[sortField];
      if (sortField === 'confidence') {
        valA = parseFloat(valA) || 0;
        valB = parseFloat(valB) || 0;
      } else if (typeof valA === 'string') {
        valA = valA.toLowerCase();
        valB = valB.toLowerCase();
      }
      if (valA < valB) return sortAsc ? -1 : 1;
      if (valA > valB) return sortAsc ? 1 : -1;
      return 0;
    });
  }, [filteredEntities, sortField, sortAsc]);

  const activeEntitiesCount = useMemo(() => {
    return entities.filter(e => e.state.trim().toLowerCase() === 'active').length;
  }, [entities]);

  // --- Dynamic Graph Filaments (Links) ---
  const graphLinks = useMemo(() => {
    const links: Array<{ source: string; target: string; weight: number; relation: string }> = [];

    for (let i = 0; i < entities.length; i++) {
      for (let j = i + 1; j < entities.length; j++) {
        const a = entities[i];
        const b = entities[j];
        let weight = 0;
        let relation = '';

        const aId = a.id.toLowerCase();
        const bId = b.id.toLowerCase();

        // 1. Direct cross references in text
        if (a.description.toLowerCase().includes(bId) || a.capabilities.toLowerCase().includes(bId) ||
            b.description.toLowerCase().includes(aId) || b.capabilities.toLowerCase().includes(aId) ||
            a.provenance.toLowerCase().includes(bId) || b.provenance.toLowerCase().includes(aId)) {
          weight += 4;
          relation = 'Architectural Reference';
        }

        // 2. Canonical Hub Connections
        const isCoreA = ['adam', 'nexus', 'nexus-prime', 'gaianexus'].includes(aId);
        const isCoreB = ['adam', 'nexus', 'nexus-prime', 'gaianexus'].includes(bId);

        if (isCoreA && isCoreB) {
          weight += 3;
          relation = 'Core Nexus Convergence';
        }

        // 3. Shared domain keywords
        const aDomains = a.domain.toLowerCase().split(/[,\s/]+/).filter(w => w.length > 3);
        const bDomains = b.domain.toLowerCase().split(/[,\s/]+/).filter(w => w.length > 3);
        const commonDomains = aDomains.filter(w => bDomains.includes(w));
        if (commonDomains.length > 0) {
          weight += commonDomains.length * 1.5;
          if (!relation) relation = `Shared ${commonDomains[0]}`;
        }

        // 4. Shared documentation source tag
        if (a.source && b.source && a.source.split(',').some(s => b.source.split(',').map(x => x.trim()).includes(s.trim()))) {
          weight += 1.2;
        }

        if (weight >= 2.5) {
          links.push({
            source: a.id,
            target: b.id,
            weight,
            relation
          });
        }
      }
    }
    return links;
  }, [entities]);

  // --- Layout Calculation with Anti-Collision Solver ---
  const defaultPositions = useMemo(() => {
    if (!entities.length) return {};
    const width = 2400;
    const height = 1600;
    const centerX = width / 2;
    const centerY = height / 2;
    const pos: Record<string, { x: number; y: number }> = {};

    if (layoutMode === 'concentric') {
      const core: typeof entities = [];
      const systems: typeof entities = [];
      const engines: typeof entities = [];
      const protocols: typeof entities = [];

      entities.forEach(e => {
        const id = e.id.toLowerCase();
        const t = e.type.toLowerCase();
        if (['adam', 'nexus', 'nexus-prime', 'gaianexus', 'project-chimera'].includes(id)) {
          core.push(e);
        } else if (t.includes('system') || t.includes('architecture') || t.includes('ecosystem')) {
          systems.push(e);
        } else if (t.includes('engine') || t.includes('intelligence') || t.includes('logic')) {
          engines.push(e);
        } else {
          protocols.push(e);
        }
      });

      core.forEach((e, i) => {
        const angle = (i / Math.max(1, core.length)) * 2 * Math.PI - Math.PI / 2;
        pos[e.id] = { x: centerX + 230 * Math.cos(angle), y: centerY + 230 * Math.sin(angle) };
      });
      systems.forEach((e, i) => {
        const angle = (i / Math.max(1, systems.length)) * 2 * Math.PI;
        pos[e.id] = { x: centerX + 500 * Math.cos(angle), y: centerY + 500 * Math.sin(angle) };
      });
      engines.forEach((e, i) => {
        const angle = (i / Math.max(1, engines.length)) * 2 * Math.PI + 0.2;
        pos[e.id] = { x: centerX + 790 * Math.cos(angle), y: centerY + 790 * Math.sin(angle) };
      });
      protocols.forEach((e, i) => {
        const angle = (i / Math.max(1, protocols.length)) * 2 * Math.PI - 0.1;
        pos[e.id] = { x: centerX + 1080 * Math.cos(angle), y: centerY + 1080 * Math.sin(angle) };
      });
    } else if (layoutMode === 'cluster') {
      const clusters: Record<string, { x: number; y: number; nodes: typeof entities }> = {
        'Core & Governance': { x: centerX - 460, y: centerY - 360, nodes: [] },
        'Reasoning & AI Engines': { x: centerX + 460, y: centerY - 360, nodes: [] },
        'Persistence & Memory': { x: centerX - 460, y: centerY + 360, nodes: [] },
        'Network & Execution Bridge': { x: centerX + 460, y: centerY + 360, nodes: [] },
        'Sensory & Visual Continuum': { x: centerX, y: centerY, nodes: [] },
      };

      entities.forEach(e => {
        const d = (e.domain + ' ' + e.type).toLowerCase();
        if (d.includes('memory') || d.includes('storage') || d.includes('vfs') || d.includes('fabric')) {
          clusters['Persistence & Memory'].nodes.push(e);
        } else if (d.includes('ai') || d.includes('engine') || d.includes('simulation') || d.includes('hamiltonian') || d.includes('dream')) {
          clusters['Reasoning & AI Engines'].nodes.push(e);
        } else if (d.includes('network') || d.includes('mesh') || d.includes('router') || d.includes('bridge') || d.includes('wan')) {
          clusters['Network & Execution Bridge'].nodes.push(e);
        } else if (d.includes('visual') || d.includes('canvas') || d.includes('interface') || d.includes('audio') || d.includes('tesseract')) {
          clusters['Sensory & Visual Continuum'].nodes.push(e);
        } else {
          clusters['Core & Governance'].nodes.push(e);
        }
      });

      Object.values(clusters).forEach(grp => {
        grp.nodes.forEach((e, i) => {
          const ring = Math.floor(i / 6);
          const posInRing = i % 6;
          const radius = 100 + ring * 140;
          const totalInRing = Math.min(6, grp.nodes.length - ring * 6);
          const angle = (posInRing / totalInRing) * 2 * Math.PI;
          pos[e.id] = {
            x: grp.x + radius * Math.cos(angle),
            y: grp.y + radius * Math.sin(angle)
          };
        });
      });
    } else {
      // Topological D3 Force Simulation
      const simNodes = entities.map(e => ({ id: e.id }));
      const simLinks = graphLinks.map(l => ({ ...l }));

      const simulation = d3.forceSimulation(simNodes as any)
        .force('center', d3.forceCenter(centerX, centerY).strength(0.06))
        .force('charge', d3.forceManyBody().strength(-1150).distanceMin(190).distanceMax(1600))
        .force('collide', d3.forceCollide().radius(130).strength(0.95))
        .force('link', d3.forceLink(simLinks).id((d: any) => d.id).distance(280).strength(0.35))
        .force('x', d3.forceX(centerX).strength(0.04))
        .force('y', d3.forceY(centerY).strength(0.04))
        .stop();

      for (let i = 0; i < 300; ++i) simulation.tick();

      simNodes.forEach((n: any) => {
        pos[n.id] = {
          x: Math.max(220, Math.min(width - 220, n.x)),
          y: Math.max(200, Math.min(height - 200, n.y))
        };
      });
    }

    // Clearance & Anti-Overlap Relaxation Solver
    const MIN_DIST_X = 230;
    const MIN_DIST_Y = 130;
    const nodeKeys = Object.keys(pos);

    for (let iter = 0; iter < 45; iter++) {
      let anyCollision = false;
      for (let i = 0; i < nodeKeys.length; i++) {
        for (let j = i + 1; j < nodeKeys.length; j++) {
          const k1 = nodeKeys[i];
          const k2 = nodeKeys[j];
          const n1 = pos[k1];
          const n2 = pos[k2];

          const dx = n2.x - n1.x;
          const dy = n2.y - n1.y;
          const absX = Math.abs(dx);
          const absY = Math.abs(dy);

          if (absX < MIN_DIST_X && absY < MIN_DIST_Y) {
            anyCollision = true;
            const overlapX = MIN_DIST_X - absX;
            const overlapY = MIN_DIST_Y - absY;
            const dirX = dx >= 0 ? 1 : -1;
            const dirY = dy >= 0 ? 1 : -1;

            n2.x += (overlapX * 0.52) * dirX;
            n1.x -= (overlapX * 0.52) * dirX;
            n2.y += (overlapY * 0.52) * dirY;
            n1.y -= (overlapY * 0.52) * dirY;

            n1.x = Math.max(160, Math.min(width - 160, n1.x));
            n1.y = Math.max(140, Math.min(height - 140, n1.y));
            n2.x = Math.max(160, Math.min(width - 160, n2.x));
            n2.y = Math.max(140, Math.min(height - 140, n2.y));
          }
        }
      }
      if (!anyCollision) break;
    }

    return pos;
  }, [entities, layoutMode, graphLinks]);

  // Combine algorithmic positions with active user drags
  const nodePositions = useMemo(() => {
    const combined = { ...defaultPositions };
    Object.keys(customPositions).forEach(id => {
      if (customPositions[id]) combined[id] = customPositions[id];
    });
    return combined;
  }, [defaultPositions, customPositions]);

  // Color thematic palette based on entity type
  const getTypeStyling = useCallback((type = '') => {
    const t = type.toLowerCase();
    if (t.includes('system') || t.includes('architecture') || t.includes('ecosystem') || t.includes('chimera')) {
      return { bg: '#e0e7ff', border: '#6366f1', text: '#312e81', fill: '#4f46e5', badge: 'bg-indigo-100 text-indigo-900 border-indigo-300' };
    }
    if (t.includes('engine') || t.includes('intelligence') || t.includes('logic')) {
      return { bg: '#f3e8ff', border: '#a855f7', text: '#581c87', fill: '#9333ea', badge: 'bg-purple-100 text-purple-900 border-purple-300' };
    }
    if (t.includes('subsystem') || t.includes('module') || t.includes('backend') || t.includes('storage')) {
      return { bg: '#e0f2fe', border: '#0284c7', text: '#0c4a6e', fill: '#0284c7', badge: 'bg-sky-100 text-sky-900 border-sky-300' };
    }
    if (t.includes('protocol') || t.includes('daemon') || t.includes('agent') || t.includes('service')) {
      return { bg: '#dcfce7', border: '#16a34a', text: '#14532d', fill: '#16a34a', badge: 'bg-emerald-100 text-emerald-900 border-emerald-300' };
    }
    if (t.includes('interface') || t.includes('anchor') || t.includes('visual') || t.includes('project')) {
      return { bg: '#ffedd5', border: '#ea580c', text: '#7c2d12', fill: '#ea580c', badge: 'bg-amber-100 text-amber-900 border-amber-300' };
    }
    return { bg: '#f1f5f9', border: '#475569', text: '#1e293b', fill: '#475569', badge: 'bg-slate-100 text-slate-800 border-slate-300' };
  }, []);

  // Visual Glyph helper
  const getVisualSymbol = (visual = '', name = '') => {
    const v = visual.toLowerCase();
    if (v.includes('crystal') || v.includes('core')) return '◈';
    if (v.includes('particle') || v.includes('starfield')) return '✦';
    if (v.includes('infinite') || v.includes('canvas')) return '⧉';
    if (v.includes('orbit') || v.includes('tensor') || v.includes('lattice')) return '⚛';
    if (v.includes('glyph') || name.includes('Sigil')) return '⨋';
    if (v.includes('matrix') || v.includes('hypercube') || v.includes('hive')) return '⎔';
    if (v.includes('pulse') || v.includes('heartbeat') || v.includes('beacon')) return '⚡';
    if (v.includes('terminal') || v.includes('gateway') || v.includes('cli')) return '⌨';
    if (v.includes('cloud') || v.includes('nebula')) return '☁';
    return '◆';
  };

  // Cursor-anchored Zoom Handler
  const handleWheel = useCallback((e: WheelEvent) => {
    e.preventDefault();
    const svgEl = svgRef.current;
    if (!svgEl) return;

    const rect = svgEl.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;

    const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;

    setTransform(prev => {
      const nextK = Math.min(Math.max(0.2, prev.k * zoomFactor), 3.0);
      const graphX = (mouseX - prev.x) / prev.k;
      const graphY = (mouseY - prev.y) / prev.k;
      const nextX = mouseX - graphX * nextK;
      const nextY = mouseY - graphY * nextK;

      return { x: nextX, y: nextY, k: nextK };
    });
  }, []);

  useEffect(() => {
    const svgEl = svgRef.current;
    if (!svgEl) return;
    svgEl.addEventListener('wheel', handleWheel, { passive: false });
    return () => {
      svgEl.removeEventListener('wheel', handleWheel);
    };
  }, [handleWheel]);

  // Window-level Mouse Pan & Drag Listener
  useEffect(() => {
    const onWindowMouseMove = (e: MouseEvent) => {
      if (isPanning) {
        setTransform(prev => ({ ...prev, x: e.clientX - panStartRef.current.x, y: e.clientY - panStartRef.current.y }));
      } else if (draggedNode && svgRef.current) {
        const svgRect = svgRef.current.getBoundingClientRect();
        const mouseX = (e.clientX - svgRect.left - transform.x) / transform.k;
        const mouseY = (e.clientY - svgRect.top - transform.y) / transform.k;
        setCustomPositions(prev => ({ ...prev, [draggedNode]: { x: mouseX, y: mouseY } }));
      }
    };

    const onWindowMouseUp = () => {
      setIsPanning(false);
      setDraggedNode(null);
    };

    window.addEventListener('mousemove', onWindowMouseMove);
    window.addEventListener('mouseup', onWindowMouseUp);
    return () => {
      window.removeEventListener('mousemove', onWindowMouseMove);
      window.removeEventListener('mouseup', onWindowMouseUp);
    };
  }, [isPanning, draggedNode, transform]);

  // Keyboard Shortcuts
  useEffect(() => {
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'Escape') {
        if (editingItem) setEditingItem(null);
        else if (isAddModalOpen) setIsAddModalOpen(false);
        else if (deleteConfirmItem) setDeleteConfirmItem(null);
      }
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, [editingItem, isAddModalOpen, deleteConfirmItem]);

  const handleSvgMouseDown = (e: React.MouseEvent) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'svg' || target.id === 'canvas-background' || target.id === 'canvas-guide-plane') {
      setIsPanning(true);
      panStartRef.current = { x: e.clientX - transform.x, y: e.clientY - transform.y };
    }
  };

  const centerOnNode = (id: string) => {
    const pos = nodePositions[id];
    if (!pos || !svgRef.current) return;
    const rect = svgRef.current.getBoundingClientRect();
    const targetX = rect.width / 2 - pos.x * transform.k;
    const targetY = rect.height / 2 - pos.y * transform.k;
    setTransform(prev => ({ ...prev, x: targetX, y: targetY }));
  };

  const zoomToFit = () => {
    if (!svgRef.current || entities.length === 0) return;
    const rect = svgRef.current.getBoundingClientRect();
    const positions = entities.map(e => nodePositions[e.id] || { x: 1200, y: 800 });

    const minX = Math.min(...positions.map(p => p.x)) - 140;
    const maxX = Math.max(...positions.map(p => p.x)) + 140;
    const minY = Math.min(...positions.map(p => p.y)) - 120;
    const maxY = Math.max(...positions.map(p => p.y)) + 120;

    const spanX = Math.max(400, maxX - minX);
    const spanY = Math.max(300, maxY - minY);

    const scaleX = rect.width / spanX;
    const scaleY = rect.height / spanY;
    const k = Math.min(Math.max(0.25, Math.min(scaleX, scaleY) * 0.9), 1.5);

    const midX = (minX + maxX) / 2;
    const midY = (minY + maxY) / 2;

    setTransform({
      k,
      x: rect.width / 2 - midX * k,
      y: rect.height / 2 - midY * k
    });
  };

  const resetView = () => {
    setTransform({ x: 80, y: 40, k: 0.72 });
    setCustomPositions({});
  };

  // Connected nodes to the current selected entity
  const connectedNeighbors = useMemo(() => {
    if (!selectedEntity) return [];
    const id = selectedEntity.id;
    const neighborIds = new Set();
    graphLinks.forEach(l => {
      if (l.source === id) neighborIds.add(l.target);
      if (l.target === id) neighborIds.add(l.source);
    });
    return entities.filter(e => neighborIds.has(e.id));
  }, [selectedEntity, graphLinks, entities]);

  // --- CRUD Handlers ---
  const handleSaveEdit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!editingItem) return;

    const updatedRow = [...(editingItem.rawRow || [])];
    while (updatedRow.length < 11) updatedRow.push('');

    updatedRow[colMap.id] = editingItem.id;
    updatedRow[colMap.type] = editingItem.type;
    updatedRow[colMap.name] = editingItem.name;
    updatedRow[colMap.description] = editingItem.description;
    updatedRow[colMap.domain] = editingItem.domain;
    updatedRow[colMap.state] = editingItem.state;
    updatedRow[colMap.confidence] = editingItem.confidence;
    updatedRow[colMap.capabilities] = editingItem.capabilities;
    updatedRow[colMap.visual_representation] = editingItem.visual;
    updatedRow[colMap.provenance_source] = editingItem.provenance;
    updatedRow[colMap.source] = editingItem.source;

    handleUpdateItem(editingItem.index_, updatedRow);
    setEditingItem(null);
  };

  const handleSaveAdd = (e: React.FormEvent, formData: any) => {
    e.preventDefault();
    const newRow = new Array(11).fill('');
    newRow[colMap.id] = formData.id || `node-${Date.now()}`;
    newRow[colMap.type] = formData.type || 'system';
    newRow[colMap.name] = formData.name || formData.id;
    newRow[colMap.description] = formData.description || '';
    newRow[colMap.domain] = formData.domain || 'general';
    newRow[colMap.state] = formData.state || 'active';
    newRow[colMap.confidence] = formData.confidence || '1.0';
    newRow[colMap.capabilities] = formData.capabilities || '';
    newRow[colMap.visual_representation] = formData.visual || '';
    newRow[colMap.provenance_source] = formData.provenance || '';
    newRow[colMap.source] = formData.source || '';

    handleInsertItem(newRow);
    setIsAddModalOpen(false);
  };

  const handleDeleteConfirm = () => {
    if (!deleteConfirmItem) return;
    handleDeleteItem(deleteConfirmItem.index_);
    if (selectedId === deleteConfirmItem.id) {
      const remaining = entities.filter(e => e.id !== deleteConfirmItem.id);
      if (remaining.length) setSelectedId(remaining[0].id);
    }
    setDeleteConfirmItem(null);
  };

  // --- Telemetry Calculations ---
  const telemetryStats = useMemo(() => {
    const totalCount = entities.length;
    const stateCounts: Record<string, number> = {};
    entities.forEach(e => {
      const st = e.state.trim() || 'unknown';
      stateCounts[st] = (stateCounts[st] || 0) + 1;
    });

    const activeCount = entities.filter(e => e.state.trim().toLowerCase() === 'active').length;

    let confSum = 0;
    let confCount = 0;
    entities.forEach(e => {
      const n = parseFloat(e.confidence);
      if (!isNaN(n)) {
        confSum += n <= 1 ? n : n / 100;
        confCount++;
      }
    });
    const avgConfidence = confCount ? ((confSum / confCount) * 100).toFixed(1) : '97.5';

    const domainCounts: Record<string, number> = {};
    entities.forEach(e => {
      e.domain.split(',').forEach(d => {
        const item = d.trim();
        if (item) domainCounts[item] = (domainCounts[item] || 0) + 1;
      });
    });
    const topDomains = Object.entries(domainCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 8);

    const typeCounts: Record<string, number> = {};
    entities.forEach(e => {
      typeCounts[e.type] = (typeCounts[e.type] || 0) + 1;
    });
    const topTypes = Object.entries(typeCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 6);

    return {
      totalCount,
      activeCount,
      stateCounts,
      avgConfidence,
      linksCount: graphLinks.length,
      topDomains,
      topTypes
    };
  }, [entities, graphLinks]);

  // Color mapping helper for node status
  const getNodeStatusColor = (st: string) => {
    const s = st.trim().toLowerCase();
    if (s === 'active') return '#16a34a';
    if (s === 'self-healing stable' || s === 'deployed') return '#0284c7';
    if (s === 'locked/frozen' || s === 'standby') return '#64748b';
    if (s === 'potted up' || s === 'calibrating') return '#d97706';
    return '#94a3b8';
  };

  return (
    <div className="flex flex-col h-screen w-screen bg-slate-100 text-slate-800 font-sans select-none overflow-hidden">
      {/* Universal Top Bar */}
      <header className="h-14 bg-white border-b border-slate-200 px-4 flex items-center justify-between shrink-0 z-20 shadow-sm">
        <div className="flex items-center space-x-3">
